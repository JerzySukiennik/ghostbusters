{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$code": {
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChildren(['n', 't'])",
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "pub": {
          ".validate": "newData.isBoolean()"
        },
        "ph": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tlobbies": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$code": {
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChildren(['n', 't'])",
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "pub": {
          ".validate": "newData.isBoolean()"
        },
        "ph": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$pid": {
            ".validate": "$pid.matches(/^[a-z0-9]{8,24}$/) && (!newData.exists() || newData.hasChildren(['nick', 'joined']))",
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "char": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "st": {
          "$pid": {
            ".validate": "$pid.matches(/^[a-z0-9]{8,24}$/)"
          }
        },
        "ev": {
          ".indexOn": [
            "t"
          ]
        }
      }
    },
    "trooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        "ev": {
          ".indexOn": [
            "t"
          ]
        },
        "players": {
          "$pid": {
            ".validate": "$pid.matches(/^[a-z0-9]{8,24}$/) && (!newData.exists() || newData.hasChildren(['nick', 'joined']))",
            "nick": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "char": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
